<Page x:Class="Helios_Launcher.Dashboard"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:local="using:Helios_Launcher">
    <Page.Resources>
        <DataTemplate x:Key="GameTile" x:DataType="local:Tile">
            <Button Width="{x:Bind TileWidth}" Height="{x:Bind TileHeight}" CornerRadius="{x:Bind Corner}" Style="{StaticResource HeliosTile}"
                    Tag="{x:Bind Game}" Click="TileClicked" GotFocus="TileFocused" LostFocus="TileUnfocused" CenterPoint="{x:Bind Center}"
                    AutomationProperties.Name="{x:Bind AccessibleName}">
                <Button.ScaleTransition><Vector3Transition Duration="0:0:0.12" /></Button.ScaleTransition>
                <Grid>
                    <TextBlock Text="{x:Bind Initials}" Visibility="{x:Bind InitialsVisibility}" FontSize="40" FontWeight="Bold" Foreground="{ThemeResource HeliosAccent}"
                               HorizontalAlignment="Center" VerticalAlignment="Center" Opacity=".8" />
                    <Image Source="{x:Bind Image}" Stretch="{x:Bind ArtStretch}" Margin="{x:Bind ArtMargin}"
                           Opacity="{x:Bind ArtOpacity}" />
                    <Rectangle VerticalAlignment="Bottom" Height="78">
                        <Rectangle.Fill>
                            <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                <GradientStop Color="#000D0F15" Offset="0" />
                                <GradientStop Color="#E60D0F15" Offset="1" />
                            </LinearGradientBrush>
                        </Rectangle.Fill>
                    </Rectangle>
                    <StackPanel VerticalAlignment="Bottom" Padding="14,0,14,10" Spacing="1">
                        <TextBlock Text="{x:Bind Title}" TextTrimming="CharacterEllipsis" FontSize="{x:Bind TitleSize}" FontWeight="SemiBold" Foreground="White" />
                        <TextBlock Text="{x:Bind Subtitle}" FontSize="12" Foreground="#B3FFFFFF" />
                    </StackPanel>
                    <Border Visibility="{x:Bind FavoriteBadge}" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="10"
                            Width="28" Height="28" CornerRadius="14" Background="#B30D0F15">
                        <FontIcon Glyph="&#xE735;" FontSize="13" Foreground="{ThemeResource HeliosAccent}" />
                    </Border>
                </Grid>
            </Button>
        </DataTemplate>

        <!-- Startup: the sun mark blooms, two light rings ripple out and the wordmark rises. About 1.4 s. -->
        <Storyboard x:Key="IntroIn">
            <DoubleAnimation Storyboard.TargetName="IntroGlow" Storyboard.TargetProperty="Opacity" From="0" To=".95" Duration="0:0:0.8">
                <DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut" /></DoubleAnimation.EasingFunction>
            </DoubleAnimation>
            <DoubleAnimation Storyboard.TargetName="IntroGlowScale" Storyboard.TargetProperty="ScaleX" From=".35" To="1" Duration="0:0:1.1">
                <DoubleAnimation.EasingFunction><ExponentialEase EasingMode="EaseOut" Exponent="5" /></DoubleAnimation.EasingFunction>
            </DoubleAnimation>
            <DoubleAnimation Storyboard.TargetName="IntroGlowScale" Storyboard.TargetProperty="ScaleY" From=".35" To="1" Duration="0:0:1.1">
                <DoubleAnimation.EasingFunction><ExponentialEase EasingMode="EaseOut" Exponent="5" /></DoubleAnimation.EasingFunction>
            </DoubleAnimation>

            <DoubleAnimation Storyboard.TargetName="IntroEmblem" Storyboard.TargetProperty="Opacity" From="0" To="1" BeginTime="0:0:0.1" Duration="0:0:0.3" />
            <DoubleAnimation Storyboard.TargetName="IntroEmblemScale" Storyboard.TargetProperty="ScaleX" From=".2" To="1" BeginTime="0:0:0.1" Duration="0:0:0.75">
                <DoubleAnimation.EasingFunction><BackEase EasingMode="EaseOut" Amplitude=".45" /></DoubleAnimation.EasingFunction>
            </DoubleAnimation>
            <DoubleAnimation Storyboard.TargetName="IntroEmblemScale" Storyboard.TargetProperty="ScaleY" From=".2" To="1" BeginTime="0:0:0.1" Duration="0:0:0.75">
                <DoubleAnimation.EasingFunction><BackEase EasingMode="EaseOut" Amplitude=".45" /></DoubleAnimation.EasingFunction>
            </DoubleAnimation>
            <DoubleAnimation Storyboard.TargetName="IntroStarSpin" Storyboard.TargetProperty="Angle" From="-150" To="0" BeginTime="0:0:0.1" Duration="0:0:1">
                <DoubleAnimation.EasingFunction><ExponentialEase EasingMode="EaseOut" Exponent="6" /></DoubleAnimation.EasingFunction>
            </DoubleAnimation>

            <DoubleAnimation Storyboard.TargetName="IntroRing" Storyboard.TargetProperty="Opacity" From=".9" To="0" BeginTime="0:0:0.35" Duration="0:0:1" />
            <DoubleAnimation Storyboard.TargetName="IntroRingScale" Storyboard.TargetProperty="ScaleX" From=".9" To="2.7" BeginTime="0:0:0.35" Duration="0:0:1">
                <DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut" /></DoubleAnimation.EasingFunction>
            </DoubleAnimation>
            <DoubleAnimation Storyboard.TargetName="IntroRingScale" Storyboard.TargetProperty="ScaleY" From=".9" To="2.7" BeginTime="0:0:0.35" Duration="0:0:1">
                <DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut" /></DoubleAnimation.EasingFunction>
            </DoubleAnimation>
            <DoubleAnimation Storyboard.TargetName="IntroRing2" Storyboard.TargetProperty="Opacity" From=".6" To="0" BeginTime="0:0:0.6" Duration="0:0:1.1" />
            <DoubleAnimation Storyboard.TargetName="IntroRing2Scale" Storyboard.TargetProperty="ScaleX" From=".9" To="3.4" BeginTime="0:0:0.6" Duration="0:0:1.1">
                <DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut" /></DoubleAnimation.EasingFunction>
            </DoubleAnimation>
            <DoubleAnimation Storyboard.TargetName="IntroRing2Scale" Storyboard.TargetProperty="ScaleY" From=".9" To="3.4" BeginTime="0:0:0.6" Duration="0:0:1.1">
                <DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut" /></DoubleAnimation.EasingFunction>
            </DoubleAnimation>

            <DoubleAnimation Storyboard.TargetName="IntroWordmark" Storyboard.TargetProperty="Opacity" From="0" To="1" BeginTime="0:0:0.55" Duration="0:0:0.5" />
            <DoubleAnimation Storyboard.TargetName="IntroWordmarkShift" Storyboard.TargetProperty="Y" From="22" To="0" BeginTime="0:0:0.55" Duration="0:0:0.6">
                <DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut" /></DoubleAnimation.EasingFunction>
            </DoubleAnimation>
            <DoubleAnimation Storyboard.TargetName="IntroLineScale" Storyboard.TargetProperty="ScaleX" From="0" To="1" BeginTime="0:0:0.8" Duration="0:0:0.6">
                <DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseInOut" /></DoubleAnimation.EasingFunction>
            </DoubleAnimation>
        </Storyboard>

        <!-- While the library is still loading, the glow breathes so the screen never looks frozen. -->
        <Storyboard x:Key="IntroWait" RepeatBehavior="Forever" AutoReverse="True">
            <DoubleAnimation Storyboard.TargetName="IntroGlow" Storyboard.TargetProperty="Opacity" From=".95" To=".5" Duration="0:0:1.1">
                <DoubleAnimation.EasingFunction><SineEase EasingMode="EaseInOut" /></DoubleAnimation.EasingFunction>
            </DoubleAnimation>
            <DoubleAnimation Storyboard.TargetName="IntroStatus" Storyboard.TargetProperty="Opacity" From=".75" To=".35" Duration="0:0:1.1" />
        </Storyboard>

        <!-- Hand-off: the intro lifts away while the dashboard settles into place. -->
        <Storyboard x:Key="IntroOut">
            <DoubleAnimation Storyboard.TargetName="IntroOverlay" Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.45">
                <DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseIn" /></DoubleAnimation.EasingFunction>
            </DoubleAnimation>
            <DoubleAnimation Storyboard.TargetName="IntroZoom" Storyboard.TargetProperty="ScaleX" To="1.08" Duration="0:0:0.45">
                <DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseIn" /></DoubleAnimation.EasingFunction>
            </DoubleAnimation>
            <DoubleAnimation Storyboard.TargetName="IntroZoom" Storyboard.TargetProperty="ScaleY" To="1.08" Duration="0:0:0.45">
                <DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseIn" /></DoubleAnimation.EasingFunction>
            </DoubleAnimation>
            <DoubleAnimation Storyboard.TargetName="ShellContent" Storyboard.TargetProperty="Opacity" From="0" To="1" BeginTime="0:0:0.12" Duration="0:0:0.5" />
            <DoubleAnimation Storyboard.TargetName="ShellZoom" Storyboard.TargetProperty="ScaleX" From=".965" To="1" BeginTime="0:0:0.12" Duration="0:0:0.6">
                <DoubleAnimation.EasingFunction><ExponentialEase EasingMode="EaseOut" Exponent="5" /></DoubleAnimation.EasingFunction>
            </DoubleAnimation>
            <DoubleAnimation Storyboard.TargetName="ShellZoom" Storyboard.TargetProperty="ScaleY" From=".965" To="1" BeginTime="0:0:0.12" Duration="0:0:0.6">
                <DoubleAnimation.EasingFunction><ExponentialEase EasingMode="EaseOut" Exponent="5" /></DoubleAnimation.EasingFunction>
            </DoubleAnimation>
        </Storyboard>
    </Page.Resources>

    <Grid x:Name="Root" Background="{ThemeResource HeliosBase}" PreviewKeyDown="RootKeyDown" SizeChanged="RootResized"
          XYFocusKeyboardNavigation="Enabled">
        <!-- Ambient backdrop: two layers crossfade so focus changes never flash. -->
        <Image x:Name="BackdropA" Stretch="UniformToFill" Opacity="0" IsHitTestVisible="False">
            <Image.OpacityTransition><ScalarTransition Duration="0:0:0.22" /></Image.OpacityTransition>
        </Image>
        <Image x:Name="BackdropB" Stretch="UniformToFill" Opacity="0" IsHitTestVisible="False">
            <Image.OpacityTransition><ScalarTransition Duration="0:0:0.22" /></Image.OpacityTransition>
        </Image>
        <Rectangle x:Name="ScrimSide" IsHitTestVisible="False">
            <Rectangle.OpacityTransition><ScalarTransition Duration="0:0:0.22" /></Rectangle.OpacityTransition>
            <Rectangle.Fill>
                <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                    <GradientStop Color="#F20D0F15" Offset="0" />
                    <GradientStop Color="#B30D0F15" Offset=".45" />
                    <GradientStop Color="#400D0F15" Offset="1" />
                </LinearGradientBrush>
            </Rectangle.Fill>
        </Rectangle>
        <Rectangle IsHitTestVisible="False">
            <Rectangle.Fill>
                <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                    <GradientStop Color="#990D0F15" Offset="0" />
                    <GradientStop Color="#000D0F15" Offset=".22" />
                    <GradientStop Color="#330D0F15" Offset=".5" />
                    <GradientStop Color="#FA0D0F15" Offset=".92" />
                </LinearGradientBrush>
            </Rectangle.Fill>
        </Rectangle>

        <Grid x:Name="ShellContent" RenderTransformOrigin=".5,.5">
            <Grid.RenderTransform><ScaleTransform x:Name="ShellZoom" /></Grid.RenderTransform>
            <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>

            <!-- Top bar -->
            <Grid x:Name="Header" Padding="40,18,40,6" ColumnSpacing="20">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                    <Border Width="32" Height="32" CornerRadius="16" Background="{ThemeResource HeliosAccent}">
                        <TextBlock Text="✦" FontSize="18" FontWeight="Bold" Foreground="{ThemeResource HeliosOnAccent}"
                                   HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <TextBlock x:Name="Brand" Text="HELIOS" FontSize="17" FontWeight="Bold" CharacterSpacing="220" VerticalAlignment="Center" />
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="4" VerticalAlignment="Center" Margin="12,0,0,0">
                    <Button x:Name="HomeTab" Content="Home" Style="{StaticResource HeliosTab}" Click="HomeClicked" />
                    <Button x:Name="LibraryTab" Content="Library" Style="{StaticResource HeliosTab}" Click="LibraryClicked" />
                    <Button x:Name="SettingsTab" Content="Settings" Style="{StaticResource HeliosTab}" Click="SettingsClicked" />
                </StackPanel>
                <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="14" VerticalAlignment="Center">
                    <Border x:Name="XboxBadge" Visibility="Collapsed" Padding="10,4" CornerRadius="12"
                            BorderThickness="1" BorderBrush="{ThemeResource HeliosAccent}">
                        <TextBlock Text="XBOX MODE" FontSize="11" FontWeight="SemiBold" CharacterSpacing="120"
                                   Foreground="{ThemeResource HeliosAccent}" />
                    </Border>
                    <StackPanel x:Name="Battery" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center" Visibility="Collapsed">
                        <FontIcon x:Name="BatteryGlyph" FontSize="18" />
                        <TextBlock x:Name="BatteryText" FontSize="15" FontWeight="SemiBold" VerticalAlignment="Center" />
                    </StackPanel>
                    <TextBlock x:Name="Clock" FontSize="17" FontWeight="SemiBold" VerticalAlignment="Center" />
                    <Button x:Name="PowerButton" Style="{StaticResource HeliosPill}" Padding="12,8" MinHeight="40" CornerRadius="20"
                            Click="PowerClicked" AutomationProperties.Name="Power options">
                        <FontIcon Glyph="&#xE7E8;" FontSize="14" />
                    </Button>
                    <Button x:Name="ExitButton" Style="{StaticResource HeliosPill}" Padding="12,8" MinHeight="40" CornerRadius="20"
                            Click="ExitClicked" AutomationProperties.Name="Exit Helios">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <FontIcon x:Name="ExitGlyph" Glyph="&#xE8BB;" FontSize="14" />
                            <TextBlock x:Name="ExitLabel" Text="Desktop" Visibility="Collapsed" />
                        </StackPanel>
                    </Button>
                </StackPanel>
            </Grid>

            <ScrollViewer x:Name="ContentScroll" Grid.Row="1" HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Hidden">
                <Grid x:Name="Body" Padding="40,8,40,24">
                    <!-- Home -->
                    <StackPanel x:Name="HomePane" Spacing="10">
                        <StackPanel.OpacityTransition><ScalarTransition Duration="0:0:0.16" /></StackPanel.OpacityTransition>
                        <StackPanel.TranslationTransition><Vector3Transition Duration="0:0:0.2" /></StackPanel.TranslationTransition>
                        <Grid x:Name="HeroArea" Height="360">
                            <StackPanel x:Name="HeroText" VerticalAlignment="Bottom" Spacing="8" MaxWidth="760" HorizontalAlignment="Left" Margin="0,0,0,14">
                                <TextBlock x:Name="HeroSource" Text="HELIOS" FontSize="13" FontWeight="SemiBold" CharacterSpacing="160"
                                           Foreground="{ThemeResource HeliosAccent}" />
                                <TextBlock x:Name="HeroTitle" Text="Your games" FontSize="56" FontWeight="Bold" LineHeight="62"
                                           TextWrapping="WrapWholeWords" MaxLines="2" TextTrimming="CharacterEllipsis" />
                                <TextBlock x:Name="HeroDescription" Text="Import your installed games or add your own."
                                           FontSize="17" Foreground="{ThemeResource HeliosMuted}" TextWrapping="Wrap" />
                                <StackPanel Orientation="Horizontal" Spacing="10" Margin="0,14,0,0">
                                    <Button x:Name="HeroAction" Style="{StaticResource HeliosAccentPill}" Click="HeroClicked">
                                        <StackPanel Orientation="Horizontal" Spacing="10">
                                            <FontIcon x:Name="HeroActionGlyph" Glyph="&#xE768;" FontSize="15" />
                                            <TextBlock x:Name="HeroActionText" Text="Play" />
                                        </StackPanel>
                                    </Button>
                                    <Button x:Name="HeroDetails" Content="Details" Style="{StaticResource HeliosPill}" MinHeight="50"
                                            CornerRadius="25" Padding="24,11" Click="HeroDetailsClicked" />
                                </StackPanel>
                            </StackPanel>
                        </Grid>
                        <StackPanel x:Name="ShelfRow" Spacing="6" Visibility="Collapsed">
                            <TextBlock x:Name="ShelfTitle" Text="Jump back in" FontSize="20" FontWeight="SemiBold" />
                            <ScrollViewer x:Name="ShelfScroll" HorizontalScrollMode="Enabled" HorizontalScrollBarVisibility="Hidden"
                                          VerticalScrollMode="Disabled" VerticalScrollBarVisibility="Disabled" Margin="-12,0">
                                <ItemsRepeater x:Name="Shelf" ItemTemplate="{StaticResource GameTile}" Margin="12,10">
                                    <ItemsRepeater.Layout><StackLayout Orientation="Horizontal" Spacing="20" /></ItemsRepeater.Layout>
                                </ItemsRepeater>
                            </ScrollViewer>
                        </StackPanel>
                        <StackPanel x:Name="FavoritesRow" Spacing="6" Visibility="Collapsed">
                            <TextBlock Text="Favorites" FontSize="20" FontWeight="SemiBold" />
                            <ScrollViewer HorizontalScrollMode="Enabled" HorizontalScrollBarVisibility="Hidden"
                                          VerticalScrollMode="Disabled" VerticalScrollBarVisibility="Disabled" Margin="-12,0">
                                <ItemsRepeater x:Name="Favorites" ItemTemplate="{StaticResource GameTile}" Margin="12,10">
                                    <ItemsRepeater.Layout><StackLayout Orientation="Horizontal" Spacing="20" /></ItemsRepeater.Layout>
                                </ItemsRepeater>
                            </ScrollViewer>
                        </StackPanel>
                    </StackPanel>

                    <!-- Library -->
                    <StackPanel x:Name="LibraryPane" Spacing="16" Visibility="Collapsed">
                        <StackPanel.OpacityTransition><ScalarTransition Duration="0:0:0.16" /></StackPanel.OpacityTransition>
                        <StackPanel.TranslationTransition><Vector3Transition Duration="0:0:0.2" /></StackPanel.TranslationTransition>
                        <StackPanel Orientation="Horizontal" Spacing="14">
                            <TextBlock Text="Library" FontSize="40" FontWeight="Bold" />
                            <TextBlock x:Name="LibraryCount" FontSize="17" VerticalAlignment="Bottom" Margin="0,0,0,8"
                                       Foreground="{ThemeResource HeliosMuted}" />
                        </StackPanel>
                        <Grid ColumnSpacing="10" MaxWidth="980" HorizontalAlignment="Left">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                            <TextBox x:Name="Search" PlaceholderText="Search your games" TextChanged="SearchChanged" MinWidth="320"
                                     MinHeight="44" CornerRadius="22" Padding="18,11" FontSize="15"
                                     AutomationProperties.Name="Search the game library" />
                            <Button x:Name="SearchKeys" Grid.Column="1" Style="{StaticResource HeliosPill}" Click="SearchKeysClicked"
                                    AutomationProperties.Name="Open the on-screen keyboard">
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <FontIcon Glyph="&#xE765;" FontSize="15" />
                                    <TextBlock Text="Keyboard" />
                                </StackPanel>
                            </Button>
                        </Grid>
                        <StackPanel x:Name="KeyboardPane" Spacing="8" Visibility="Collapsed" MaxWidth="980" HorizontalAlignment="Left">
                            <ItemsRepeater x:Name="SearchKeyboard">
                                <ItemsRepeater.Layout>
                                    <UniformGridLayout MinItemWidth="62" MinItemHeight="46" MinColumnSpacing="6" MinRowSpacing="6"
                                                       MaximumRowsOrColumns="13" ItemsStretch="Fill" />
                                </ItemsRepeater.Layout>
                            </ItemsRepeater>
                            <Button Content="Done" Style="{StaticResource HeliosAccentPill}" Click="DoneTyping" />
                        </StackPanel>
                        <ScrollViewer HorizontalScrollMode="Enabled" HorizontalScrollBarVisibility="Hidden"
                                      VerticalScrollMode="Disabled" VerticalScrollBarVisibility="Disabled" Margin="-4,0">
                        <StackPanel x:Name="ChipRow" Orientation="Horizontal" Spacing="8" Margin="4,3">
                            <StackPanel x:Name="FilterChips" Orientation="Horizontal" Spacing="8" />
                            <Rectangle Width="1" Height="26" Margin="8,0" Fill="{ThemeResource HeliosChip}" VerticalAlignment="Center" />
                            <Button x:Name="RefreshButton" Style="{StaticResource HeliosPill}" Click="RefreshClicked" AutomationProperties.Name="Refresh library">
                                <StackPanel Orientation="Horizontal" Spacing="8"><FontIcon Glyph="&#xE72C;" FontSize="14" /><TextBlock Text="Refresh" /></StackPanel>
                            </Button>
                            <Button x:Name="AddButton" Style="{StaticResource HeliosPill}" Click="AddFileClicked" AutomationProperties.Name="Add a game file">
                                <StackPanel Orientation="Horizontal" Spacing="8"><FontIcon Glyph="&#xE710;" FontSize="14" /><TextBlock Text="Add file" /></StackPanel>
                            </Button>
                            <Button x:Name="AddWindowsButton" Style="{StaticResource HeliosPill}" Click="AddWindowsClicked" AutomationProperties.Name="Add an installed app">
                                <StackPanel Orientation="Horizontal" Spacing="8"><FontIcon Glyph="&#xE71D;" FontSize="14" /><TextBlock Text="Installed app" /></StackPanel>
                            </Button>
                        </StackPanel>
                        </ScrollViewer>
                        <TextBlock x:Name="EmptyLibrary" Text="No games yet. Add a game or refresh the library." FontSize="17"
                                   Foreground="{ThemeResource HeliosMuted}" TextWrapping="Wrap" Margin="0,20,0,0" />
                        <ItemsRepeater x:Name="GameGrid" ItemTemplate="{StaticResource GameTile}" Margin="0,8,0,0">
                            <ItemsRepeater.Layout>
                                <UniformGridLayout MinItemWidth="300" MinItemHeight="169" MinColumnSpacing="20" MinRowSpacing="22" />
                            </ItemsRepeater.Layout>
                        </ItemsRepeater>
                    </StackPanel>

                    <!-- Details -->
                    <StackPanel x:Name="DetailsPane" Spacing="14" Visibility="Collapsed" MaxWidth="900" HorizontalAlignment="Left">
                        <StackPanel.OpacityTransition><ScalarTransition Duration="0:0:0.16" /></StackPanel.OpacityTransition>
                        <StackPanel.TranslationTransition><Vector3Transition Duration="0:0:0.2" /></StackPanel.TranslationTransition>
                        <Button x:Name="BackButton" Style="{StaticResource HeliosPill}" Click="BackClicked" AutomationProperties.Name="Back">
                            <StackPanel Orientation="Horizontal" Spacing="8"><FontIcon Glyph="&#xE72B;" FontSize="14" /><TextBlock Text="Back" /></StackPanel>
                        </Button>
                        <Border x:Name="DetailsArtFrame" Height="240" Width="520" HorizontalAlignment="Left" CornerRadius="16"
                                Background="{ThemeResource HeliosArtwork}" Margin="0,10,0,4">
                            <Image x:Name="DetailsImage" Stretch="UniformToFill" />
                        </Border>
                        <TextBlock x:Name="DetailsSource" FontSize="13" FontWeight="SemiBold" CharacterSpacing="160"
                                   Foreground="{ThemeResource HeliosAccent}" />
                        <TextBlock x:Name="DetailsTitle" FontSize="52" FontWeight="Bold" TextWrapping="Wrap" LineHeight="58" />
                        <TextBlock x:Name="DetailsMeta" FontSize="17" Foreground="{ThemeResource HeliosMuted}" TextWrapping="Wrap" />
                        <StackPanel Orientation="Horizontal" Spacing="10" Margin="0,10,0,0">
                            <Button x:Name="PlayButton" Style="{StaticResource HeliosAccentPill}" Click="PlayClicked">
                                <StackPanel Orientation="Horizontal" Spacing="10"><FontIcon Glyph="&#xE768;" FontSize="15" /><TextBlock Text="Play" /></StackPanel>
                            </Button>
                            <Button x:Name="FavoriteButton" Style="{StaticResource HeliosPill}" MinHeight="50" CornerRadius="25" Padding="22,11" Click="FavoriteClicked">
                                <StackPanel Orientation="Horizontal" Spacing="10">
                                    <FontIcon x:Name="FavoriteGlyph" Glyph="&#xE734;" FontSize="15" />
                                    <TextBlock x:Name="FavoriteText" Text="Favorite" />
                                </StackPanel>
                            </Button>
                            <Button x:Name="RemoveButton" Style="{StaticResource HeliosPill}" MinHeight="50" CornerRadius="25" Padding="22,11" Click="RemoveClicked">
                                <StackPanel Orientation="Horizontal" Spacing="10"><FontIcon Glyph="&#xE74D;" FontSize="15" /><TextBlock Text="Remove" /></StackPanel>
                            </Button>
                        </StackPanel>
                        <TextBlock x:Name="DetailsTarget" FontSize="12" Foreground="{ThemeResource HeliosMuted}" TextWrapping="Wrap"
                                   IsTextSelectionEnabled="True" Margin="0,8,0,0" />
                    </StackPanel>

                    <!-- Settings -->
                    <StackPanel x:Name="SettingsPane" Spacing="16" Visibility="Collapsed" HorizontalAlignment="Left" MaxWidth="760">
                        <StackPanel.OpacityTransition><ScalarTransition Duration="0:0:0.16" /></StackPanel.OpacityTransition>
                        <StackPanel.TranslationTransition><Vector3Transition Duration="0:0:0.2" /></StackPanel.TranslationTransition>
                        <TextBlock Text="Settings" FontSize="40" FontWeight="Bold" />

                        <Border Style="{StaticResource HeliosCardStyle}">
                            <StackPanel Spacing="12">
                                <TextBlock Text="Xbox mode" FontSize="22" FontWeight="SemiBold" />
                                <Grid ColumnSpacing="24" RowSpacing="8">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions><RowDefinition /><RowDefinition /><RowDefinition /></Grid.RowDefinitions>
                                    <TextBlock Text="Status" Foreground="{ThemeResource HeliosMuted}" />
                                    <TextBlock x:Name="ModeState" Grid.Column="1" FontWeight="SemiBold" />
                                    <TextBlock Grid.Row="1" Text="Home app" Foreground="{ThemeResource HeliosMuted}" />
                                    <TextBlock x:Name="HomeState" Grid.Row="1" Grid.Column="1" FontWeight="SemiBold" />
                                    <TextBlock Grid.Row="2" Text="At sign-in" Foreground="{ThemeResource HeliosMuted}" />
                                    <TextBlock x:Name="SignInState" Grid.Row="2" Grid.Column="1" FontWeight="SemiBold" />
                                </Grid>
                                <TextBlock x:Name="ModeMessage" TextWrapping="Wrap" Foreground="{ThemeResource HeliosMuted}" />
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <Button x:Name="ChooseHomeButton" Content="Choose home app" Style="{StaticResource HeliosPill}" Click="OpenModeClicked" />
                                    <Button x:Name="ModeSwitchButton" Content="Enter Xbox mode" Style="{StaticResource HeliosPill}" Click="ModeSwitchClicked" />
                                </StackPanel>
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource HeliosCardStyle}">
                            <StackPanel Spacing="14">
                                <TextBlock Text="Appearance" FontSize="22" FontWeight="SemiBold" />
                                <TextBlock Text="Changes apply right away. Themes are saved on this PC and can be shared as files."
                                           TextWrapping="Wrap" Foreground="{ThemeResource HeliosMuted}" />
                                <StackPanel x:Name="AppearanceRows" Spacing="14" />
                                <ToggleSwitch x:Name="HintsToggle" Header="Show controller hints" Toggled="HintsChanged" />
                                <ToggleSwitch x:Name="ClockToggle" Header="Show the clock" Toggled="ClockChanged" />
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <Button Content="Export theme" Style="{StaticResource HeliosPill}" Click="ExportThemeClicked" />
                                    <Button Content="Import theme" Style="{StaticResource HeliosPill}" Click="ImportThemeClicked" />
                                </StackPanel>
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource HeliosCardStyle}">
                            <StackPanel Spacing="10">
                                <TextBlock Text="Display and startup" FontSize="22" FontWeight="SemiBold" />
                                <ToggleSwitch x:Name="FullScreenToggle" Header="Full screen on the desktop" Toggled="FullScreenChanged" />
                                <TextBlock x:Name="FullScreenMessage" TextWrapping="Wrap" Foreground="{ThemeResource HeliosMuted}" Visibility="Collapsed"
                                           Text="Xbox mode keeps Helios full screen. This setting applies when you return to the desktop." />
                                <ToggleSwitch x:Name="StartupToggle" Header="Start Helios at Windows sign-in" Toggled="StartupChanged" />
                                <TextBlock x:Name="StartupMessage" TextWrapping="Wrap" Foreground="{ThemeResource HeliosMuted}" />
                                <Button Content="Windows startup settings" Style="{StaticResource HeliosPill}" Click="OpenStartupClicked" />
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource HeliosCardStyle}">
                            <StackPanel Spacing="10">
                                <TextBlock Text="About" FontSize="22" FontWeight="SemiBold" />
                                <TextBlock x:Name="AboutText" TextWrapping="Wrap" Foreground="{ThemeResource HeliosMuted}" />
                                <TextBlock x:Name="RecoveryText" TextWrapping="Wrap" Foreground="{ThemeResource HeliosMuted}" Visibility="Collapsed" />
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <Button Content="Power options" Style="{StaticResource HeliosPill}" Click="PowerClicked" />
                                    <Button x:Name="AboutExitButton" Content="Exit Helios" Style="{StaticResource HeliosPill}" Click="AboutExitClicked" />
                                </StackPanel>
                            </StackPanel>
                        </Border>
                    </StackPanel>

                    <!-- Installed app picker -->
                    <StackPanel x:Name="PickerPane" Spacing="12" Visibility="Collapsed" MaxWidth="900" HorizontalAlignment="Left">
                        <StackPanel.OpacityTransition><ScalarTransition Duration="0:0:0.16" /></StackPanel.OpacityTransition>
                        <StackPanel.TranslationTransition><Vector3Transition Duration="0:0:0.2" /></StackPanel.TranslationTransition>
                        <Button Style="{StaticResource HeliosPill}" Click="BackClicked" AutomationProperties.Name="Back">
                            <StackPanel Orientation="Horizontal" Spacing="8"><FontIcon Glyph="&#xE72B;" FontSize="14" /><TextBlock Text="Back" /></StackPanel>
                        </Button>
                        <TextBlock Text="Add an installed app" FontSize="36" FontWeight="Bold" TextWrapping="Wrap" />
                        <ListView x:Name="WindowsPicker" SelectionMode="None" MaxHeight="520">
                            <ListView.ItemTemplate>
                                <DataTemplate x:DataType="local:Tile">
                                    <Button Tag="{x:Bind Game}" Content="{x:Bind Title}" Click="WindowsAppClicked" Style="{StaticResource HeliosPill}"
                                            CornerRadius="12" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left" Margin="0,3" />
                                </DataTemplate>
                            </ListView.ItemTemplate>
                        </ListView>
                    </StackPanel>
                </Grid>
            </ScrollViewer>

            <!-- Footer -->
            <Grid x:Name="Footer" Grid.Row="2" Padding="40,10,40,16" ColumnSpacing="16">
                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                <TextBlock x:Name="Status" Text="Loading library…" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"
                           AutomationProperties.LiveSetting="Polite" Foreground="{ThemeResource HeliosMuted}" />
                <StackPanel x:Name="Hints" Grid.Column="1" Orientation="Horizontal" Spacing="18" VerticalAlignment="Center" />
            </Grid>
        </Grid>

        <!-- Power and exit menu. Modal: controller focus stays inside while it is open. -->
        <Grid x:Name="PowerOverlay" Visibility="Collapsed" Background="#D907080C" TabFocusNavigation="Cycle"
              XYFocusKeyboardNavigation="Enabled" Tapped="PowerOverlayTapped">
            <Border x:Name="PowerCard" Style="{StaticResource HeliosCardStyle}" Background="{ThemeResource HeliosPanel}"
                    HorizontalAlignment="Center" VerticalAlignment="Center" Width="420" Margin="16" Padding="28,24"
                    Tapped="PowerCardTapped">
                <StackPanel Spacing="10">
                    <TextBlock x:Name="PowerTitle" Text="Power" FontSize="28" FontWeight="Bold" TextWrapping="Wrap" />
                    <TextBlock x:Name="PowerMessage" TextWrapping="Wrap" Foreground="{ThemeResource HeliosMuted}" Visibility="Collapsed" />
                    <StackPanel x:Name="PowerChoices" Spacing="8" Margin="0,6,0,0" />
                </StackPanel>
            </Border>
        </Grid>

        <!-- Startup intro, also the loading screen. Collapsed (and its storyboards stopped) once the dashboard is ready. -->
        <Grid x:Name="IntroOverlay" Background="{ThemeResource HeliosBase}" RenderTransformOrigin=".5,.5"
              AutomationProperties.Name="Helios is starting">
            <Grid.RenderTransform><ScaleTransform x:Name="IntroZoom" /></Grid.RenderTransform>
            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="0">
                <Grid Width="300" Height="300" HorizontalAlignment="Center">
                    <Ellipse x:Name="IntroGlow" Width="300" Height="300" Opacity="0" RenderTransformOrigin=".5,.5">
                        <Ellipse.RenderTransform><ScaleTransform x:Name="IntroGlowScale" /></Ellipse.RenderTransform>
                        <Ellipse.Fill>
                            <RadialGradientBrush>
                                <GradientStop x:Name="IntroGlowInner" Color="#66FFB86B" Offset="0" />
                                <GradientStop x:Name="IntroGlowMid" Color="#1FFFB86B" Offset=".55" />
                                <GradientStop x:Name="IntroGlowOuter" Color="#00FFB86B" Offset="1" />
                            </RadialGradientBrush>
                        </Ellipse.Fill>
                    </Ellipse>
                    <Ellipse x:Name="IntroRing" Width="116" Height="116" Opacity="0" StrokeThickness="2"
                             Stroke="{ThemeResource HeliosAccent}" RenderTransformOrigin=".5,.5">
                        <Ellipse.RenderTransform><ScaleTransform x:Name="IntroRingScale" /></Ellipse.RenderTransform>
                    </Ellipse>
                    <Ellipse x:Name="IntroRing2" Width="116" Height="116" Opacity="0" StrokeThickness="1"
                             Stroke="{ThemeResource HeliosAccent}" RenderTransformOrigin=".5,.5">
                        <Ellipse.RenderTransform><ScaleTransform x:Name="IntroRing2Scale" /></Ellipse.RenderTransform>
                    </Ellipse>
                    <Border x:Name="IntroEmblem" Width="112" Height="112" CornerRadius="56" Opacity="0"
                            Background="{ThemeResource HeliosAccent}" RenderTransformOrigin=".5,.5">
                        <Border.RenderTransform><ScaleTransform x:Name="IntroEmblemScale" /></Border.RenderTransform>
                        <TextBlock Text="✦" FontSize="60" FontWeight="Bold" Foreground="{ThemeResource HeliosOnAccent}"
                                   HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,-4,0,0" RenderTransformOrigin=".5,.55">
                            <TextBlock.RenderTransform><RotateTransform x:Name="IntroStarSpin" /></TextBlock.RenderTransform>
                        </TextBlock>
                    </Border>
                </Grid>
                <StackPanel x:Name="IntroWordmark" Opacity="0" Spacing="14" Margin="0,-28,0,0" HorizontalAlignment="Center">
                    <StackPanel.RenderTransform><TranslateTransform x:Name="IntroWordmarkShift" /></StackPanel.RenderTransform>
                    <TextBlock Text="HELIOS" FontSize="34" FontWeight="Bold" CharacterSpacing="520" HorizontalAlignment="Center"
                               Margin="18,0,0,0" />
                    <Rectangle Height="2" Width="168" RadiusX="1" RadiusY="1" Fill="{ThemeResource HeliosAccent}"
                               HorizontalAlignment="Center" RenderTransformOrigin=".5,.5">
                        <Rectangle.RenderTransform><ScaleTransform x:Name="IntroLineScale" ScaleX="0" /></Rectangle.RenderTransform>
                    </Rectangle>
                </StackPanel>
            </StackPanel>
            <TextBlock x:Name="IntroStatus" Text="Getting your games ready" Opacity="0" FontSize="15"
                       Foreground="{ThemeResource HeliosMuted}" HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="0,0,0,64" />
        </Grid>
    </Grid>
</Page>
