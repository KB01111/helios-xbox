<?xml version="1.0" encoding="utf-8"?>
<Application
    x:Class="Helios_Launcher.App"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:Helios_Launcher">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <XamlControlsResources xmlns="using:Microsoft.UI.Xaml.Controls" />
            </ResourceDictionary.MergedDictionaries>
            <SolidColorBrush x:Key="HeliosSelected" Color="#28D58B45" />
            <SolidColorBrush x:Key="HeliosAccent" Color="#ECAF72" />
            <ResourceDictionary.ThemeDictionaries>
                <ResourceDictionary x:Key="Dark">
                    <SolidColorBrush x:Key="HeliosBase" Color="#13151C" />
                    <SolidColorBrush x:Key="HeliosPanel" Color="#1C1F28" />
                    <SolidColorBrush x:Key="HeliosArtwork" Color="#29232C" />
                    <SolidColorBrush x:Key="HeliosOnAccent" Color="#211308" />
                    <SolidColorBrush x:Key="SystemControlFocusVisualPrimaryBrush" Color="#FFCA87" />
                </ResourceDictionary>
                <ResourceDictionary x:Key="Light">
                    <SolidColorBrush x:Key="HeliosBase" Color="#F5F2EF" />
                    <SolidColorBrush x:Key="HeliosPanel" Color="#FFFBF7" />
                    <SolidColorBrush x:Key="HeliosArtwork" Color="#E8DACD" />
                    <SolidColorBrush x:Key="HeliosAccent" Color="#874714" />
                    <SolidColorBrush x:Key="HeliosOnAccent" Color="#FFFFFF" />
                    <SolidColorBrush x:Key="SystemControlFocusVisualPrimaryBrush" Color="#874714" />
                </ResourceDictionary>
                <ResourceDictionary x:Key="HighContrast">
                    <SolidColorBrush x:Key="HeliosBase" Color="{ThemeResource SystemColorWindowColor}" />
                    <SolidColorBrush x:Key="HeliosPanel" Color="{ThemeResource SystemColorWindowColor}" />
                    <SolidColorBrush x:Key="HeliosArtwork" Color="{ThemeResource SystemColorWindowColor}" />
                    <SolidColorBrush x:Key="HeliosAccent" Color="{ThemeResource SystemColorHighlightColor}" />
                    <SolidColorBrush x:Key="HeliosOnAccent" Color="{ThemeResource SystemColorHighlightTextColor}" />
                </ResourceDictionary>
            </ResourceDictionary.ThemeDictionaries>
        </ResourceDictionary>
    </Application.Resources>
</Application>
